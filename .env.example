# Demo defaults — no production secrets.
APP_ENV=demo
API_HOST=0.0.0.0
API_PORT=8080
DATABASE_URL=sqlite:///./data/funnel.db
PUBLIC_BASE_URL=http://127.0.0.1:8080

# Leave empty to run with mock AI (recommended for portfolio demo).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional: real Telegram bot for live demo. Empty = API-only demo mode.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
